generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ContactType {
  MEMBER
  REGISTRANT
  VOLUNTEER
  DONOR
  OTHER
}

enum LifecycleStage {
  NEW
  ENGAGED
  QUALIFIED
  CONVERTED
  LOST
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELED
}

enum MembershipInterval {
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  WAIVED
}

enum PaymentMethod {
  OFFLINE
  CASH
  CHECK
  CARD
  BANK_TRANSFER
  STRIPE
  OTHER
}

enum PaymentPurpose {
  MEMBERSHIP
  EVENT
  DONATION
  SPONSORSHIP
  OTHER
}

enum SponsorInvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum CommunicationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum CommunicationPurpose {
  PAYMENT_RECEIPT
  EVENT_CONFIRMATION
  EVENT_REMINDER
  RENEWAL_REMINDER
  MEMBER_SIGN_IN
  HOUSEHOLD_INVITE
  GENERAL
}

enum HouseholdInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED
  COMPLETED
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELED
  ATTENDED
  NO_SHOW
  WAITLISTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  REGISTER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// JanaGana's own SaaS plan for the tenant organization (distinct from a
/// tenant's own MembershipTier, which is that org's dues plan for ITS members).
enum TenantPlan {
  FREE
  PRO
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

/// An organization admin account.
/// INVARIANT: One Tenant ←→ One Clerk Organization (clerkOrgId is unique).
/// Created ONLY during explicit admin onboarding — never from public registration.
model Tenant {
  id                 String       @id @default(cuid())
  name               String
  slug               String       @unique
  clerkOrgId         String       @unique
  status             TenantStatus @default(ACTIVE)
  publicTagline      String?
  publicContactEmail String?
  publicContactPhone String?
  logoUrl            String?
  /// Public member directory on the portal is opt-in per tenant, off by default.
  directoryEnabled   Boolean      @default(false)
  /// JanaGana's own SaaS plan for this tenant — see TenantPlan doc comment.
  plan               TenantPlan   @default(FREE)
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique
  planRenewsAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenantAdmins  TenantAdmin[]
  contacts      Contact[]
  households    Household[]
  customFieldDefinitions CustomFieldDefinition[]
  tiers         MembershipTier[]
  memberships   Membership[]
  eventTicketTypes EventTicketType[]
  payments      PaymentRecord[]
  receipts      PaymentReceipt[]
  stripeEvents  StripeWebhookEvent[]
  communications CommunicationMessage[]
  events        Event[]
  registrations EventRegistration[]
  auditLogs     AuditLog[]
  contactLoginTokens ContactLoginToken[]
  contactSessions    ContactSession[]
  sponsors        Sponsor[]
  sponsorInvoices SponsorInvoice[]
  householdInvites HouseholdInvite[]
}

/// Cache of which Clerk users are admins of which Tenants.
/// Source of truth is Clerk organization membership — this is a read-cache only.
/// Always re-validate against Clerk before writes.
model TenantAdmin {
  id          String   @id @default(cuid())
  tenantId    String
  clerkUserId String
  role        String   @default("admin")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clerkUserId])
  @@index([clerkUserId])
}

/// A public-facing person (visitor, registrant, member, donor).
/// INVARIANT: Contacts are NEVER Clerk users.
///            Creating a Contact MUST NEVER create a Clerk Organization.
model Contact {
  id                  String      @id @default(cuid())
  tenantId            String
  firstName           String
  lastName            String
  email               String
  phone               String?
  type                ContactType @default(REGISTRANT)
  source              String?
  interestType        String?
  lastActivityAt      DateTime?
  lastActivitySummary String?
  notes               String?
  tags                String[]    @default([])
  externalSource      String?
  externalId          String?
  importedAt          DateTime?
  originalMetadata    Json?
  householdId         String?
  /// Contact has opted in to being listed on the tenant's public directory.
  /// Defaults off — the directory only ever shows name + type/tags, never email/phone.
  directoryOptIn      Boolean     @default(false)
  /// Values for the tenant's CustomFieldDefinitions, keyed by CustomFieldDefinition.key.
  customFieldValues   Json?
  /// First-touch attribution — set only on create, never overwritten by later activity.
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  referrerUrl         String?
  lifecycleStage      LifecycleStage @default(NEW)
  leadScore           Int            @default(0)
  leadScoreUpdatedAt  DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  household     Household?          @relation("HouseholdMembers", fields: [householdId], references: [id], onDelete: SetNull)
  payerFor      Household[]         @relation("HouseholdPayer")
  memberships   Membership[]
  registrations EventRegistration[]
  payments      PaymentRecord[]
  receipts      PaymentReceipt[]
  communications CommunicationMessage[]
  loginTokens   ContactLoginToken[]
  sessions      ContactSession[]
  sentHouseholdInvites HouseholdInvite[] @relation("HouseholdInvitesSent")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, source])
  @@index([tenantId, interestType])
  @@index([tenantId, lastActivityAt])
  @@index([householdId])
  @@index([tenantId, lifecycleStage])
  @@index([tenantId, leadScore])
}

/// Groups multiple Contacts into a family/household for CRM visibility —
/// e.g. renewal reminders and event RSVPs shown per household, not just per person.
/// Deliberately NOT a shared-billing entity: Membership stays 1:1 with the paying Contact.
model Household {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  payerContactId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members Contact[] @relation("HouseholdMembers")
  payer   Contact?  @relation("HouseholdPayer", fields: [payerContactId], references: [id], onDelete: SetNull)
  invites HouseholdInvite[]

  @@index([tenantId])
  @@index([payerContactId])
}

/// A member-initiated invite to join their household, confirmed by the invitee's
/// own click-through — NOT a unilateral admin-style link. Prevents one member from
/// silently attaching another person's existing account to their household by email.
/// INVARIANT: Never stores the raw token — only its SHA-256 hash (see ContactLoginToken).
model HouseholdInvite {
  id                String                @id @default(cuid())
  tenantId          String
  householdId       String
  invitedByContactId String
  inviteeEmail      String
  tokenHash         String                @unique
  status            HouseholdInviteStatus @default(PENDING)
  expiresAt         DateTime
  respondedAt       DateTime?
  /// Set once accepted — the contact (existing or newly created) that actually joined.
  acceptedContactId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy Contact @relation("HouseholdInvitesSent", fields: [invitedByContactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([householdId])
  @@index([tenantId, inviteeEmail])
}

/// Up to 3 active admin-defined fields per tenant (enforced in app code).
/// Values live on Contact.customFieldValues, keyed by `key`.
model CustomFieldDefinition {
  id        String          @id @default(cuid())
  tenantId  String
  key       String
  label     String
  type      CustomFieldType @default(TEXT)
  options   Json?
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// A short-lived, single-use magic-link token for portal sign-in.
/// INVARIANT: Never stores the raw token — only its SHA-256 hash.
model ContactLoginToken {
  id         String    @id @default(cuid())
  tenantId   String
  contactId  String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
}

/// A long-lived portal session for a signed-in Contact.
/// INVARIANT: Never stores the raw token — only its SHA-256 hash.
model ContactSession {
  id         String    @id @default(cuid())
  tenantId   String
  contactId  String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
}

/// A membership plan offered by a tenant.
model MembershipTier {
  id            String             @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  amountCents   Int
  interval      MembershipInterval
  stripePriceId String?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([tenantId])
}

/// A contact's enrollment in a membership tier.
model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  contactId String
  tierId    String
  status    MembershipStatus @default(ACTIVE)
  startsAt  DateTime         @default(now())
  expiresAt DateTime?
  autoRenew Boolean          @default(false)
  source    String           @default("admin")
  notes     String?
  stripeSubscriptionId String? @unique
  /// Opaque token used by the public /api/membership-verify endpoint and QR/wallet
  /// passes instead of the raw membership id, so a guessable cuid can't be scanned.
  verifyToken String? @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tier    MembershipTier @relation(fields: [tierId], references: [id])
  payments PaymentRecord[]
  receipts PaymentReceipt[]
  communications CommunicationMessage[]

  @@index([tenantId])
  @@index([contactId])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
}

/// Tenant-scoped money ledger. Stripe/offline/donation/event payments all land here.
model PaymentRecord {
  id             String         @id @default(cuid())
  tenantId       String
  contactId      String?
  membershipId   String?
  eventId        String?
  registrationId String?
  sponsorInvoiceId String?
  amountCents    Int
  currency       String         @default("USD")
  status         PaymentStatus  @default(PAID)
  method         PaymentMethod  @default(OFFLINE)
  purpose        PaymentPurpose @default(MEMBERSHIP)
  provider       String?
  providerRef    String?
  stripeSubscriptionId String?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  event      Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  sponsorInvoice SponsorInvoice? @relation(fields: [sponsorInvoiceId], references: [id], onDelete: SetNull)
  receipt    PaymentReceipt?

  @@index([tenantId])
  @@index([tenantId, purpose])
  @@index([tenantId, status])
  @@index([contactId])
  @@index([membershipId])
  @@index([eventId])
  @@index([registrationId])
  @@index([sponsorInvoiceId])
  @@index([paidAt])
  @@index([stripeSubscriptionId])
  @@unique([provider, providerRef])
}

/// Issued proof of payment for a completed transaction.
model PaymentReceipt {
  id             String   @id @default(cuid())
  tenantId       String
  paymentId      String   @unique
  contactId      String?
  membershipId   String?
  receiptNumber  String   @unique
  recipientEmail String
  recipientName  String?
  amountCents    Int
  currency       String   @default("USD")
  description    String
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment    PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  membership Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  communications CommunicationMessage[]

  @@index([tenantId])
  @@index([contactId])
  @@index([membershipId])
  @@index([issuedAt])
}

/// Idempotency marker for Stripe webhooks already processed.
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  tenantId      String?
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
  metadata      Json?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([processedAt])
}

/// An event created by a tenant admin.
model Event {
  id          String      @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  description String?
  startsAt    DateTime
  location    String?
  status      EventStatus @default(DRAFT)
  priceCents  Int         @default(0)
  capacity    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketTypes   EventTicketType[]
  registrations EventRegistration[]
  payments      PaymentRecord[]
  communications CommunicationMessage[]
  sponsors      Sponsor[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// A purchasable or free ticket option for a tenant event.
model EventTicketType {
  id               String   @id @default(cuid())
  tenantId         String
  eventId          String
  name             String
  description      String?
  priceCents       Int      @default(0)
  memberPriceCents Int?
  capacity         Int?
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([tenantId])
  @@index([eventId])
}

/// A public visitor's registration for an event.
/// INVARIANT: Creating an EventRegistration MUST NEVER create a Clerk Organization.
model EventRegistration {
  id        String             @id @default(cuid())
  tenantId  String
  eventId   String
  contactId String
  ticketTypeId String?
  quantity  Int                @default(1)
  amountCents Int              @default(0)
  status    RegistrationStatus @default(CONFIRMED)
  checkedInAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  ticketType EventTicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  payments PaymentRecord[]
  communications CommunicationMessage[]

  @@unique([eventId, contactId])
  @@index([tenantId])
  @@index([eventId])
  @@index([ticketTypeId])
}

/// Transactional communication outbox. Provider delivery can process queued rows.
model CommunicationMessage {
  id             String               @id @default(cuid())
  tenantId       String
  contactId      String?
  membershipId   String?
  eventId        String?
  registrationId String?
  receiptId      String?
  purpose        CommunicationPurpose
  status         CommunicationStatus  @default(QUEUED)
  recipientEmail String
  recipientName  String?
  subject        String
  body           String
  scheduledFor   DateTime?
  sentAt         DateTime?
  provider       String?
  providerRef    String?
  error          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  membership   Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  event        Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  receipt      PaymentReceipt?    @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId])
  @@index([membershipId])
  @@index([eventId])
  @@index([registrationId])
  @@index([receiptId])
  @@index([tenantId, status])
  @@index([scheduledFor])
}

/// Immutable audit trail for all tenant operations.
model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String?
  actorUserId String?
  action      AuditAction
  metadata    Json?
  createdAt   DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

/// A sponsor of the tenant's events/programs (e.g. a gala sponsor) — distinct
/// from Contact, which models people, not organizations.
model Sponsor {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  /// Freeform, e.g. "Gold" — tenants define their own tier names.
  tier             String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  website          String?
  notes            String?
  eventId          String?
  stripeCustomerId String?   @unique
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event    Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  invoices SponsorInvoice[]

  @@index([tenantId])
  @@index([eventId])
}

/// A one-off invoice billed to a Sponsor. Drafts stay local until sent —
/// sending pushes it to Stripe (collection_method=send_invoice), which emails
/// the sponsor a hosted payment link.
model SponsorInvoice {
  id               String               @id @default(cuid())
  tenantId         String
  sponsorId        String
  description      String
  amountCents      Int
  currency         String               @default("USD")
  status           SponsorInvoiceStatus @default(DRAFT)
  dueDate          DateTime?
  stripeInvoiceId  String?              @unique
  hostedInvoiceUrl String?
  sentAt           DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sponsor  Sponsor         @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  payments PaymentRecord[]

  @@index([tenantId])
  @@index([sponsorId])
  @@index([tenantId, status])
}
