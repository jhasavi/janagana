{
  "buildCommand": "npx prisma db push --accept-data-loss && npx prisma generate && npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/renewal-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/recompute-stale-leads",
      "schedule": "0 15 * * *"
    }
  ]
}
