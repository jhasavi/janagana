# App (required)
NEXT_PUBLIC_APP_URL=http://localhost:3020
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clerk (development placeholders)
# Keep dev Clerk keys mapped to dev DB tenant records.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Clerk (production placeholders)
# Use these only in production secret storage, not committed files.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# CLERK_SECRET_KEY=sk_live_REPLACE_ME
# CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe (optional; required for paid public membership checkout)
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Email delivery (optional; required for receipts + renewal reminders in production)
# ZEPTOMAIL_TOKEN=Zoho-enczapikey REPLACE_ME
# ZEPTOMAIL_FROM=noreply@yourdomain.com
# ZEPTOMAIL_FROM_NAME=JanaGana

# Vercel cron + ops alerts (production)
# CRON_SECRET=generate_a_long_random_string
# OPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Real Clerk smoke tests only (never commit actual values)
# CLERK_E2E_USER_EMAIL=
# CLERK_E2E_USER_PASSWORD=

# Ops-only reconciliation for missed Clerk deletion webhooks
# ENABLE_CLERK_TENANT_RECONCILIATION=false
# CLERK_TENANT_RECONCILIATION_TOKEN=REPLACE_ME

# Self-serve signup (recommended on for public launch): lets a brand-new Clerk
# sign-up create their own organization/tenant from /onboarding/create-organization.
# Set to false to go back to admin-only, invite-based onboarding.
ENABLE_SELF_SERVE_ONBOARDING=true

# Apple Wallet (optional; "Add to Apple Wallet" hidden until fully configured)
# Base64-encode each PEM file: base64 -i cert.pem | tr -d '\n'
# APPLE_WALLET_CERT_BASE64=
# APPLE_WALLET_KEY_BASE64=
# APPLE_WALLET_KEY_PASSPHRASE=
# APPLE_WALLET_WWDR_BASE64=
# APPLE_WALLET_PASS_TYPE_ID=pass.com.yourdomain.membership
# APPLE_WALLET_TEAM_ID=REPLACE_ME
# APPLE_WALLET_ICON_BASE64=

# Google Wallet (optional; "Add to Google Wallet" hidden until fully configured)
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# Playwright e2e (optional)
# Default e2e uses built-in dev server on port 3022. Do not set PLAYWRIGHT_BASE_URL
# unless you run PLAYWRIGHT_USE_EXTERNAL_SERVER=true against an already-running app.
# PLAYWRIGHT_PORT=3022
# PLAYWRIGHT_USE_EXTERNAL_SERVER=false
